# ── IDCS Environment Variables ───────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is git-ignored. NEVER commit real secrets.

# ── Required ──────────────────────────────────────────────────────────────────
IDCS_SECRET_KEY=change_this_to_a_long_random_string
GEMINI_API_KEY=your_google_generativeai_api_key_here

# ── Optional: Africa's Talking SMS (leave blank for dev/log-only mode) ────────
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=sandbox

# ── Optional: Safaricom Daraja webhook verification secret ────────────────────
DARAJA_WEBHOOK_SECRET=
